FROM node:20-alpine AS base
WORKDIR /app

ARG APP_NAME=extranet
ARG APP_PORT=3000

FROM base AS deps
COPY package.json package-lock.json turbo.json ./
COPY apps/${APP_NAME}/package.json apps/${APP_NAME}/
COPY packages/shared/package.json packages/shared/
RUN npm ci --workspace=@revoar/${APP_NAME} --workspace=@revoar/shared --include-workspace-root

FROM base AS builder
ARG APP_NAME=extranet
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build -w @revoar/shared -w @revoar/${APP_NAME}

FROM base AS runner
ARG APP_NAME=extranet
ARG APP_PORT=3000
ENV APP_NAME=${APP_NAME}
ENV PORT=${APP_PORT}
WORKDIR /app
COPY --from=builder /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=builder /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=builder /app/apps/${APP_NAME}/public ./apps/${APP_NAME}/public
EXPOSE ${APP_PORT}
CMD ["sh", "-c", "node apps/$APP_NAME/server.js"]
