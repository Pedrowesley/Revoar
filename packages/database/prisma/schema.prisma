generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OPERATOR
  SUPER_ADMIN
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum HotelStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
}

enum SupplierType {
  DIRECT
  HOTELBEDS
  OMNIBEES
}

enum ActorType {
  PARTNER
  ADMIN
  GUEST
  SYSTEM
}

enum BookingMode {
  INSTANT
  REQUEST
}

enum RoomBookingMode {
  INHERIT
  INSTANT
  REQUEST
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
  NON_REFUNDABLE
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
}

enum BlockReason {
  UNAVAILABLE
  RENTED_OFFLINE
}

enum BookingStatus {
  HELD
  PAYMENT_PENDING
  CONFIRMED
  REQUESTED
  AWAITING_PAYMENT
  DECLINED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  CAPTURED
  REFUNDED
  PARTIAL_REFUND
  FAILED
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(OPERATOR)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Partner {
  id          String        @id @default(uuid())
  legalName   String        @map("legal_name")
  tradeName   String?       @map("trade_name")
  cnpj        String        @unique
  email       String
  phone       String
  contactName        String        @map("contact_name")
  logoUrl            String?       @map("logo_url")
  detailsConfirmedAt DateTime?     @map("details_confirmed_at")
  status             PartnerStatus @default(PENDING)
  users       PartnerUser[]
  hotels      Hotel[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("partners")
}

model PartnerUser {
  id           String   @id @default(uuid())
  partnerId    String   @map("partner_id")
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  passwordResets PasswordResetToken[]

  @@map("partner_users")
}

model PasswordResetToken {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  user      PartnerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique @map("token_hash")
  expiresAt DateTime    @map("expires_at")
  usedAt    DateTime?   @map("used_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Hotel {
  id              String               @id @default(uuid())
  partnerId       String               @map("partner_id")
  partner         Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name            String
  slug            String               @unique
  description     String
  starRating      Decimal?             @map("star_rating") @db.Decimal(2, 1)
  addressLine     String               @map("address_line")
  city            String
  state           String               @db.Char(2)
  zipCode         String               @map("zip_code")
  country         String               @default("BR") @db.Char(2)
  latitude        Decimal?             @db.Decimal(10, 7)
  longitude       Decimal?             @db.Decimal(10, 7)
  phone           String
  checkInTime     String               @default("14:00") @map("check_in_time")
  checkOutTime    String               @default("12:00") @map("check_out_time")
  supplierType    SupplierType         @default(DIRECT) @map("supplier_type")
  status          HotelStatus          @default(DRAFT)
  rejectionReason String?              @map("rejection_reason")
  bookingMode     BookingMode          @default(INSTANT) @map("booking_mode")
  amenities       Json                 @default("[]")
  houseRules      String?              @map("house_rules")
  roomTypes       RoomType[]
  images          HotelImage[]
  statusHistory   HotelStatusHistory[]
  ratePlans       RatePlan[]
  bookings        Booking[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([status])
  @@index([city])
  @@map("hotels")
}

model RoomType {
  id               String @id @default(uuid())
  hotelId          String @map("hotel_id")
  hotel            Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name             String
  description      String
  maxAdults        Int    @map("max_adults")
  maxChildren      Int    @default(0) @map("max_children")
  maxOccupancy     Int    @map("max_occupancy")
  bedConfiguration String @map("bed_configuration")
  amenities        Json   @default("[]")
  sizeSqm          Int?   @map("size_sqm")
  sortOrder        Int    @default(0) @map("sort_order")
  bookingMode      RoomBookingMode @default(INHERIT) @map("booking_mode")
  images           RoomImage[]
  ratePlans        RatePlan[]
  inventory        RoomInventory[]
  locks            InventoryLock[]
  bookings         Booking[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([hotelId])
  @@map("room_types")
}

model RoomImage {
  id         String   @id @default(uuid())
  roomTypeId String   @map("room_type_id")
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  altText    String?  @map("alt_text")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([roomTypeId])
  @@map("room_images")
}

model HotelImage {
  id        String  @id @default(uuid())
  hotelId   String  @map("hotel_id")
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  altText   String? @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([hotelId])
  @@map("hotel_images")
}

model HotelStatusHistory {
  id         String       @id @default(uuid())
  hotelId    String       @map("hotel_id")
  hotel      Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  fromStatus HotelStatus? @map("from_status")
  toStatus   HotelStatus  @map("to_status")
  reason     String?
  actorType  ActorType    @map("actor_type")
  actorId    String       @map("actor_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([hotelId])
  @@map("hotel_status_history")
}

model RatePlan {
  id                     String             @id @default(uuid())
  hotelId                String             @map("hotel_id")
  hotel                  Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId             String             @map("room_type_id")
  roomType               RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name                   String
  cancellationPolicy     CancellationPolicy @map("cancellation_policy")
  mealPlan               MealPlan           @default(ROOM_ONLY) @map("meal_plan")
  minNights              Int                @default(1) @map("min_nights")
  payAtProperty          String?            @map("pay_at_property")
  active                 Boolean            @default(true)
  dailyRates             DailyRate[]
  bookings               Booking[]
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@index([roomTypeId])
  @@index([hotelId])
  @@map("rate_plans")
}

model DailyRate {
  id         String   @id @default(uuid())
  ratePlanId String   @map("rate_plan_id")
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  priceCents Int      @map("price_cents")

  @@unique([ratePlanId, date])
  @@index([date])
  @@map("daily_rates")
}

model RoomInventory {
  id           String       @id @default(uuid())
  roomTypeId   String       @map("room_type_id")
  roomType     RoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date         DateTime     @db.Date
  unitsForSale Int          @default(0) @map("units_for_sale")
  blockedUnits Int          @default(0) @map("blocked_units")
  blockReason  BlockReason? @map("block_reason")

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_inventory")
}

model InventoryLock {
  id         String   @id @default(uuid())
  bookingId  String   @map("booking_id")
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomTypeId String   @map("room_type_id")
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  quantity   Int
  expiresAt  DateTime @map("expires_at")

  @@index([roomTypeId, date])
  @@index([bookingId])
  @@map("inventory_locks")
}

model Booking {
  id                String        @id @default(uuid())
  bookingCode       String        @unique @map("booking_code")
  status            BookingStatus
  bookingMode       BookingMode   @map("booking_mode")
  hotelId           String        @map("hotel_id")
  hotel             Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomTypeId        String        @map("room_type_id")
  roomType          RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  ratePlanId        String        @map("rate_plan_id")
  ratePlan          RatePlan      @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)
  checkIn           DateTime      @map("check_in") @db.Date
  checkOut          DateTime      @map("check_out") @db.Date
  nights            Int
  adults            Int
  children          Int
  quantity          Int
  totalCents        Int           @map("total_cents")
  guestEmail        String        @map("guest_email")
  guestPhone        String        @map("guest_phone")
  guestCpfHash      String        @map("guest_cpf_hash")
  guestMessage      String?       @map("guest_message")
  declineReason     String?       @map("decline_reason")
  cancelReason      String?       @map("cancel_reason")
  snapshot          Json
  idempotencyKey    String        @unique @map("idempotency_key")
  accessTokenHash   String        @unique @map("access_token_hash")
  holdExpiresAt     DateTime?     @map("hold_expires_at")
  respondBy         DateTime?     @map("respond_by")
  payBy             DateTime?     @map("pay_by")
  holdExtended      Boolean       @default(false) @map("hold_extended")
  confirmedAt       DateTime?     @map("confirmed_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  guests            BookingGuest[]
  payments          Payment[]
  locks             InventoryLock[]
  statusHistory     BookingStatusHistory[]
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([guestEmail])
  @@index([hotelId, status])
  @@index([roomTypeId, status, checkIn, checkOut])
  @@map("bookings")
}

model BookingGuest {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind      String
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  age       Int?

  @@index([bookingId])
  @@map("booking_guests")
}

model BookingStatusHistory {
  id         String         @id @default(uuid())
  bookingId  String         @map("booking_id")
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  reason     String?
  actorType  ActorType      @map("actor_type")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("booking_status_history")
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String        @map("booking_id")
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents    Int           @map("amount_cents")
  method         PaymentMethod
  status         PaymentStatus
  installments   Int           @default(1)
  pixCopyPaste   String?       @map("pix_copy_paste")
  sandbox        Boolean       @default(true)
  capturedAt     DateTime?     @map("captured_at")
  refundedCents  Int           @default(0) @map("refunded_cents")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([bookingId])
  @@map("payments")
}
